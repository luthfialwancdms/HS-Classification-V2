    "/api/admin/versions/{id}/diff": {
      "get": {
        "tags": [
          "Versions"
        ],
        "summary": "What activating this version would change, compared with the active version (or with `against`):\r\ncodes added, removed, reworded, and texts that differ only by OCR-prone characters.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Version to look at (the candidate).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "against",
            "in": "query",
            "description": "\"active\" (default) or the id of another version.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chapter",
            "in": "query",
            "description": "Only list entries of this 2-digit chapter; the counts stay for the whole version.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "take",
            "in": "query",
            "description": "Entries listed per category (1-1000).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 200
