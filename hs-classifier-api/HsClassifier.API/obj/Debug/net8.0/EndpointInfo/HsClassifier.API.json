    "/api/classification/cases": {
      "get": {
        "tags": [
          "Classification"
        ],
        "summary": "Riwayat klasifikasi (paged, newest first). Classifier/Viewer: own cases; Admin/ExpertReviewer: all.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Determined | NeedClarification | NeedExpertReview | Rejected",
            "schema": {
              "$ref": "#/components/schemas/CaseStatus"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Cari di kode final atau fakta barang (nama dagang/generik)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
