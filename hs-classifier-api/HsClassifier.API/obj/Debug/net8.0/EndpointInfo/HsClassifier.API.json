    "/api/classification/start": {
      "post": {
        "tags": [
          "Classification"
        ],
        "summary": "Mulai klasifikasi dari fakta barang.",
        "description": "Contoh body: `{ \"facts\": { \"commercial_name\": \"Excavator\", \"primary_function\": \"menggali tanah\", \"assembled_status\": \"complete\" } }`.\r\nResponse `status`: DETERMINED (finalCode + tariffs), NEED_CLARIFICATION (questions + candidateCodes;\r\njawab lewat `POST /{caseId}/facts`), NEED_EXPERT_REVIEW (tanpa kode final, candidateCodes untuk ahli),\r\natau ERROR (message berisi alasan validasi). Semua status selain ERROR mengembalikan caseId.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassificationStartRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassificationStartRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClassificationStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/classification/{caseId}/facts": {
      "post": {
        "tags": [
          "Classification"
        ],
        "summary": "Tambah fakta (jawaban klarifikasi) ke case; fakta lama digabung, lalu klasifikasi dijalankan ulang.",
