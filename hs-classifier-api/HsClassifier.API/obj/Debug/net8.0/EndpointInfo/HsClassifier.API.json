{
  "openapi": "3.0.4",
  "info": {
    "title": "HS Classifier V2 API",
    "description": "Klasifikasi HS berbasis database BTKI 2022 + KUM HS 1-6. Error body: { message } dengan status 400 (input/transisi tidak valid), 401/403 (auth), 404 (case/versi tidak ada), 422 (template berisi error). Status klasifikasi: DETERMINED | NEED_CLARIFICATION | NEED_EXPERT_REVIEW | ERROR (ERROR = validasi gagal: CODE_NOT_FOUND, INVALID_FORMAT, PARENT_MISSING, DESCRIPTION_MISMATCH, INACTIVE_CODE, SOURCE_ID_INVALID).",
    "version": "v1"
  },
  "paths": {
    "/api/admin/btki/upload": {
      "post": {
        "tags": [
          "AdminImport"
        ],
        "summary": "Upload BTKI (DOCX, atau PDF resmi per Bab / gabungan) ke sebuah versi: parse, dry run,\r\nsimpan laporan validasi (import batch), dan masukkan node STRUCTURE_AMBIGUITY ke antrian review.",
        "parameters": [
          {
            "name": "versionId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              },
              "encoding": {
                "files": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/btki/commit/{versionId}": {
      "post": {
        "tags": [
          "AdminImport"
        ],
        "summary": "Commit file yang sama dengan upload terakhir. Diblokir bila ada error atau ambiguitas pending.",
        "parameters": [
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              },
              "encoding": {
                "files": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
