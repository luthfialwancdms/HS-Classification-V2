    {
      "dot": "cyan",
      "title": "Admin Data Center",
      "items": [
        "Upload DOCX: BTKI 2022 (14.273 kode) + EN WCO (65.833 paragraf) + Legal Notes",
        "Parser OpenXML: ekstrak kode, uraian ID/EN, tarif, source location",
        "Validasi hierarki, format XXXX.XX.XX, duplikat, total count",
        "State machine: UPLOADED → PARSING → VALIDATING → DRY_RUN → COMMITTED → ACTIVE"
      ]
    },
    {
      "dot": "emerald",
      "title": "Classification Engine (KUM HS 1–6)",
      "items": [
        "Fact Engine: LLM ekstrak 35 fakta — status UNKNOWN / CONFLICTING / VERIFIED",
        "Candidate Generator: cari heading dari DB via lexical, sinonim, fungsi, EN",
        "Rules Engine: terapkan KUM HS 1→2→3→4→5→6 secara berurutan",
        "Validator: REJECT kode jika tidak ada di DB atau parent/uraian tidak cocok",
        "Tariff Lookup: MFN, FTA (referensi), PPN, PPh22 — disclaimer wajib"
      ]
    },
    {
      "dot": "rose",
      "title": "Aturan Kritis: AI vs Database",
      "items": [
        "LLM hanya boleh: ekstrak fakta, normalisasi unit, buat pertanyaan klarifikasi",
        "LLM DILARANG menghasilkan kode HS, uraian, atau angka tarif dari memorinya",
        "Semua kode HS wajib dari tabel btki_tariff_lines di MySQL",
        "Validator menolak hasil jika kode tidak ditemukan di database aktif"
      ]
    },
    {
      "dot": "amber",
      "title": "MySQL — Single Source of Truth",
      "items": [
        "btki_tariff_lines: 14.273 kode HS aktif BTKI 2022 (bilingual ID + EN)",
        "explanatory_notes: 65.833 paragraf EN WCO dengan tipe dan source_id",
        "section / chapter / subheading notes + mfn / fta / tax rates",
        "classification_cases + reasoning_events: audit trail lengkap per session"
      ]
    }
